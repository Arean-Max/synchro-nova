{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synchro Nova",
  "version": "2.2.1",
  "identifier": "app.synchro.performance",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Synchro Nova",
        "width": 980,
        "height": 620,
        "minWidth": 860,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "devtools": false,
        "additionalBrowserArgs": "--disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings --disable-client-side-phishing-detection --safebrowsing-disable-auto-update --disable-default-apps --disable-extensions --disable-breakpad --no-crash-upload --disable-speech-api --disable-speech-synthesis-api --disable-notifications --disable-wake-on-wifi --disable-features=Translate,OptimizationHints,MediaRouter,DialMediaRouteProvider,InterestFeedContentSuggestions,SpeechSynthesis --disk-cache-size=16777216 --media-cache-size=8388608"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: asset://localhost http://asset.localhost https://asset.localhost; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: asset://localhost http://asset.localhost https://asset.localhost; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$LOCALAPPDATA/**",
            "$RESOURCE/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "resources": {
      "crates/webview2-com-sys/x64/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsi"
      }
    }
  }
}
